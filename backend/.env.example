PORT=5000
NODE_ENV=development
ENABLE_DEMO_SEED=false
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority&appName=<appName>
# Generate locally with: openssl rand -base64 32
JWT_SECRET=<generated-secret>
JWT_EXPIRES_IN=15m
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Resend: verified sender and public frontend origin
RESEND_API_KEY=
MAIL_FROM=
APP_ORIGIN=https://clevermatch.onrender.com
